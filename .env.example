# Copy to .env. OpenAQ ingestion requires OPENAQ_API_KEY; weather needs no key.
# Get a free OpenAQ key at https://explore.openaq.org/register.
# Never put private keys or API keys in frontend environment variables.
# The Vite frontend proxies the local API; never copy these values to VITE_*.
OPENAQ_API_KEY=
# Ethereum Sepolia only (chain ID 11155111). Use a funded throwaway testnet wallet.
# The API needs RPC_URL and a registry for verification; it needs no PRIVATE_KEY.
RPC_URL=
PRIVATE_KEY=
# Populate after the deployment receipt confirms a contract address.
REGISTRY_ADDRESS=

# Absolute path or a path relative to the repository root.
ECOPROOF_DATA_DIR=data
